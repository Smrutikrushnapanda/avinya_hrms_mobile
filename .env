# Leave these unset for local dev — the app now auto-detects your LAN IP
# from the Metro/Expo dev server connection, so it works on home, office,
# or any other Wi-Fi network without editing this file.
# Uncomment only to force a specific backend (e.g. cloud, or a machine
# other than the one running `expo start`):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.3:8080
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.3:8080
